      <edge source="ClinicalNote:028998ee-babc-4096-9b28-001bc2f9a84e:517c676b-9d05-4343-b32e-501911137809" target="Concept:SYMPTOM:pain" id="19" label="HAS_SYMPTOM">
        <attvalues>
          <attvalue for="4" value="HAS_SYMPTOM" />
          <attvalue for="6" value="Aya Kobayashi&#10;&#10;Presenting Complaint&#10;Abdominal pain&#10;&#10;History of Presenting Complaint&#10;3-day hx of abdominal pain and constipation." />
          <attvalue for="5" value="0" />
        </attvalues>
      </edge>
      <edge source="ClinicalNote:028998ee-babc-4096-9b28-001bc2f9a84e:9d66207f-c495-436e-a83e-bb3c551206a8" target="Concept:SYMPTOM:headache" id="20" label="ABSENT_SYMPTOM">
        <attvalues>
          <attvalue for="4" value="ABSENT_SYMPTOM" />
          <attvalue for="6" value="Yuri Matsumoto (FY1)&#10;&#10;Presenting Complaint&#10;3-day hx of abdominal pain - 3-day hx of worsening adominal pain - Site: Lower abdmoen - Onset: Gradual - Character: Dull ache - Radiates: No radiartion - Associations: Constipation, reduced appetite - Timing: Constant - Exacerbating factors: Eating - Severity: 6/10 on arrival, reduced to 5/10 after IV fluids (0.9% sodium chloride) in ED - Note: Single dose of 10mg bisacodyl administered in ED&#10;&#10;Review of Systems&#10;- Cardiovascular: No chest pain, palpitat" />
          <attvalue for="5" value="0" />
        </attvalues>
      </edge>
      <edge source="ClinicalNote:028998ee-babc-4096-9b28-001bc2f9a84e:9d66207f-c495-436e-a83e-bb3c551206a8" target="Concept:SYMPTOM:pain" id="21" label="ABSENT_SYMPTOM">
        <attvalues>
          <attvalue for="4" value="ABSENT_SYMPTOM" />
          <attvalue for="6" value="Yuri Matsumoto (FY1)&#10;&#10;Presenting Complaint&#10;3-day hx of abdominal pain - 3-day hx of worsening adominal pain - Site: Lower abdmoen - Onset: Gradual - Character: Dull ache - Radiates: No radiartion - Associations: Constipation, reduced appetite - Timing: Constant - Exacerbating factors: Eating - Severity: 6/10 on arrival, reduced to 5/10 after IV fluids (0.9% sodium chloride) in ED - Note: Single dose of 10mg bisacodyl administered in ED&#10;&#10;Review of Systems&#10;- Cardiovascular: No chest pain, palpitat" />
          <attvalue for="5" value="0" />
        </attvalues>
      </edge>
      <edge source="ClinicalNote:028998ee-babc-4096-9b28-001bc2f9a84e:9d66207f-c495-436e-a83e-bb3c551206a8" target="Concept:SYMPTOM:nausea" id="22" label="ABSENT_SYMPTOM">
