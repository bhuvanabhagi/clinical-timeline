      <edge source="ClinicalNote:028998ee-babc-4096-9b28-001bc2f9a84e:87d658f4-d59d-4747-b655-2f90228ec92c" target="Concept:PROCEDURE_TEST:x-ray" id="18" label="MENTIONS_TEST">
